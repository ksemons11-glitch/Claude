# --- core ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://director:director@localhost:5432/director
APP_BASE_URL=http://localhost:8000
APP_AUTH_SECRET=
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
APP_API_TOKEN=
BUSINESS_TIMEZONE=Europe/Warsaw
REPORT_CURRENCY=PLN
MODE=OBSERVE
EXECUTION_ENABLED=false
KILL_SWITCH=false
CONFIG_DIR=config
# set to a directory to run every adapter from replayed fixtures (demo / tests)
FIXTURE_DIR=

# --- sources (leave empty -> connector reports UNCONFIGURED, never zeros) --------------
NAILUKS_MCP_URL=
NAILUKS_MCP_TOKEN=
BASELINKER_TOKEN=
META_ACCESS_TOKEN=
META_API_VERSION=
GETHOOKED_MCP_URL=
GETHOOKED_MCP_TOKEN=

# --- reasoning model (optional; deterministic report is produced without it) ----------
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_DAILY_BUDGET_PLN=0

# --- notifications ----------------------------------------------------------------------
NOTIFICATION_CHANNEL=in_app
