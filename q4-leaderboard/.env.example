# --- Wymagane ---
# Baza MySQL/MariaDB z panelu Hostido: mysql://UŻYTKOWNIK:HASŁO@localhost:3306/NAZWA_BAZY
DATABASE_URL=mysql://user:password@localhost:3306/leaderboard
# true dla baz w chmurze wymagających szyfrowanego połączenia (np. Aiven, TiDB Cloud)
DATABASE_SSL=false
# Publiczny adres aplikacji (używany w linkach w mailach)
APP_URL=https://nextlevel-q4.pl
# Kod dostępu do eventu ustawiany przy PIERWSZYM uruchomieniu (potem zmieniasz go w panelu admina)
EVENT_ACCESS_CODE=zmien-mnie
# E-maile, które po rejestracji od razu dostają rolę administratora (oddzielone przecinkami)
ADMIN_EMAILS=twoj@email.pl

# --- Event (używane tylko przy pierwszym uruchomieniu) ---
EVENT_NAME=Next Level Q4 Leaderboard
EVENT_SLUG=q4-2026
Q4_START=2026-10-01
Q4_END=2026-12-31

# --- Linki prawne i kontakt ---
TERMS_URL=https://twoja-strona.pl/regulamin
PRIVACY_URL=https://twoja-strona.pl/polityka-prywatnosci
DATA_CONTROLLER=Nazwa firmy, adres
# Osoba na Discordzie, do której piszą czekający na akceptację
SUPPORT_DISCORD=Adrian - Młody

# --- Maile (Brevo SMTP: Ustawienia → SMTP & API) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=login-smtp@brevo
SMTP_PASS=klucz-smtp
MAIL_FROM="Next Level Q4 <ranking@nextlevel-q4.pl>"
# Wysyłać mail "konto zaakceptowane"? (true/false)
SEND_APPROVAL_EMAILS=true
